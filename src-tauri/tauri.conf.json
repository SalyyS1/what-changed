{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "What Changed",
  "mainBinaryName": "WhatChanged",
  "identifier": "dev.whatchanged.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && node scripts/generate-third-party-notices.mjs --prepare"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "What Changed",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "What Changed contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../dist-installer/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "shortDescription": "It worked before. What changed?",
    "longDescription": "Records meaningful Windows change locally and answers what changed before something broke. Non-elevated, offline, no account.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "../assets/brand/installer-header.bmp",
        "uninstallerHeaderImage": "../assets/brand/installer-header.bmp",
        "sidebarImage": "../assets/brand/installer-sidebar.bmp",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
