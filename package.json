{
  "name": "what-changed",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Windows change recorder and causal investigator. Answers: it worked before, what changed?",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-standalone.ps1",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:perf": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-perf.ps1",
    "test:watch": "vitest",
    "tauri": "tauri",
    "rs:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rs:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rs:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "rs:bench": "cargo run --release --manifest-path src-tauri/Cargo.toml --example redaction_bench",
    "gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --features devtools --example export_bindings",
    "check:bindings": "cargo run --locked --manifest-path src-tauri/Cargo.toml --features devtools --example export_bindings -- --check",
    "check:versions": "node scripts/check-versions.mjs",
    "check:no-network": "node scripts/check-no-network.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:launch": "node scripts/check-launch-copy.mjs",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:nsis": "node scripts/check-nsis-script.mjs",
    "prepare:third-party-review": "node scripts/prepare-third-party-review.mjs",
    "export:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-brand-assets.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "verify": "bun run check && bun run check:bindings && bun run test && bun run rs:fmt && bun run rs:lint && bun run rs:test",
    "mem": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-memory.ps1",
    "toolchain": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-toolchain.ps1",
    "check:bundle": "node scripts/bundle-size.mjs",
    "perf:soak": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/soak.ps1",
    "core:no-network": "node scripts/check-no-network.mjs",
    "runner:test": "node scripts/check-runner-policy.mjs",
    "runner:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-preview-runner.ps1",
    "check:runner-bundle": "node scripts/check-runner-bundle.mjs",
    "check:runner-notices": "node scripts/check-runner-notices.mjs",
    "site:build": "node wiki-site/build.mjs",
    "site:test": "node --test wiki-site/tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:download": "node scripts/check-download-manifest.mjs",
    "check:owner-release": "node scripts/check-owner-release.mjs"
  },
  "dependencies": {
    "@tanstack/svelte-virtual": "3.13.36",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "bits-ui": "2.19.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^24",
    "@types/three": "0.185.4",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
